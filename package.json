{
  "name": "genshin-api",
  "version": "1.0.0",
  "description": "API de datos de Genshin Impact para el Taller DevOps (basada en genshindev/api).",
  "private": true,
  "main": "dist/index.js",
  "license": "OSL-3.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "jest --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts"
    ],
    "coverageReporters": [
      "lcov",
      "text-summary"
    ]
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.1",
    "koa": "^3.3.0",
    "koa-helmet": "^9.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/koa": "^3.0.3",
    "@types/koa__cors": "^5.0.1",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
